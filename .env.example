# Vzor nastaveni. Zkopirujte jako .env (ten se do gitu NENAHRAVA) a doplnte hodnoty.
# Na serveru (Render) se tyto hodnoty zadavaji v Environment, ne do souboru.
# Vsechno je nepovinne. Klice jdou nastavit i v aplikaci (Data -> Umela inteligence).

# Heslo spravce online verze (aspon 12 znaku). Bez nej je online verze jen ke cteni.
TS_ADMIN_HESLO=

# --- Umela inteligence pro onboarding agenta ---
# Poskytovatel:
#   placene:  anthropic | openai | mistral | openrouter
#   zdarma:   gemini | groq | openrouter_free | cloudflare | cohere | zai | nvidia | gonka | ovh | kilo | llm7
#   ostatni:  ollama (na vasem pocitaci) | vlastni (OpenAI-kompatibilni API, adresa v LLM_URL)
# Bezplatne tarify mohou dotazy ukladat nebo pouzit k treninku - onboarding posila udaje o firme.
LLM_POSKYTOVATEL=anthropic
# Nazev modelu (prazdne = vychozi navrh; aktualni seznam: v aplikaci tlacitko "Nacist modely")
LLM_MODEL=
# Adresa API jen pro ollama / vlastni (napr. http://localhost:11434/v1)
LLM_URL=
# Klic k vybranemu poskytovateli. U kazdeho nastavte i limit utrat!
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
# zdarma (ovh, kilo, llm7 funguji i bez klice)
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
GONKA_API_KEY=
OVH_API_KEY=
KILO_API_KEY=
LLM7_API_KEY=

# --- Dalsi klice ---
# Token Hlidace statu (zdarma, hlidacstatu.cz)
HLIDAC_TOKEN=
# Exa (vyhledavani na webu pro export do Obsidianu)
EXA_API_KEY=

# --- Limity proti zneuziti (vychozi hodnoty) ---
TS_LIMIT_LLM_DEN=30
TS_LIMIT_EXA_DEN=40
TS_LIMIT_ZA_MINUTU=120
TS_LIMIT_DRAHE_ZA_MINUTU=10
